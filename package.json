{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based deployment and management platform for GenLayer Intelligent Contracts.",
  "homepage": "https://genshipyard.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luch91/shipyard.git"
  },
  "bugs": {
    "url": "https://github.com/luch91/shipyard/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "predeploy": "node scripts/predeploy-check.mjs",
    "deploy": "vercel --prod",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/redis": "^1.38.0",
    "@wagmi/core": "2.22.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.1.7",
    "genlayer-js": "^0.28.4",
    "jose": "^6.2.4",
    "lucide-react": "^0.577.0",
    "lz-string": "^1.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "^2.4.1",
    "viem": "^2.55.8",
    "wagmi": "^2.19.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@vinext/cloudflare": "1.1.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.37",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5",
    "vinext": "1.2.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wrangler": "4.151.1"
  },
  "type": "module"
}
